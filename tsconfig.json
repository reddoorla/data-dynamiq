{
  // Kit 3 writes its generated config into node_modules as `$app/tsconfig`
  // (kit 2: ./.svelte-kit/tsconfig.json) and no longer supplies `include`, so
  // the list below is ours: kit's own example plus tests/, which kit 2's
  // generated include covered.
  "extends": "$app/tsconfig",
  "include": ["src", "tests", "*"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "typescript-svelte-plugin"
      }
    ]
  }
  // Path aliases are handled by https://svelte.dev/docs/kit/configuration#alias and https://svelte.dev/docs/kit/configuration#files
  //
  // If you want to overwrite includes/excludes, make sure to copy over the relevant includes/excludes
  // from the referenced tsconfig.json - TypeScript does not merge them in
}
