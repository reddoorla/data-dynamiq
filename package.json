{
	"name": "data-dynamiq",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "concurrently \"pnpm:vite:dev\" \"pnpm:slicemachine\" --prefix-colors blue,magenta",
		"vite:dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --plugin prettier-plugin-svelte . && eslint .",
		"format": "prettier --write . --plugin prettier-plugin-svelte .",
		"slicemachine": "start-slicemachine"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@slicemachine/adapter-sveltekit": "^0.3.96",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"concurrently": "^9.2.1",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.18.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"slice-machine-ui": "^2.21.3",
		"svelte": "^5.55.10",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "^8.0.14"
	},
	"type": "module",
	"packageManager": "pnpm@10.33.1",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"protobufjs",
			"sharp"
		]
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^6.5.1",
		"@fortawesome/free-brands-svg-icons": "^6.5.1",
		"@fortawesome/free-regular-svg-icons": "^6.5.1",
		"@fortawesome/free-solid-svg-icons": "^6.5.1",
		"@fortawesome/svelte-fontawesome": "^0.2.2",
		"@prismicio/client": "^7.21.8",
		"@prismicio/svelte": "^2.2.1",
		"@tailwindcss/vite": "^4.3.0",
		"svelte-gestures": "^5.2.2",
		"svelte-select": "^5.8.3",
		"svelte-turnstile": "^0.8.0"
	}
}
